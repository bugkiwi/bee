{
  "name": "bee",
  "version": "0.1.0",
  "description": "Claude Code Controller — deterministic coding agent orchestrator",
  "type": "module",
  "bin": {
    "bee": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --compile --outfile dist/bee",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome check src/",
    "lint:fix": "bunx biome check --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
